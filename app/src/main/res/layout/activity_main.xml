<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp">

            <ImageView
                android:id="@+id/homeButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="9dp"
                android:src="@drawable/ic_undo"
                app:tint="@color/text_light"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/app_title"
                android:textColor="@color/text_light"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                style="@style/ScoreBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/ScoreLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/score" />

                <TextView
                    android:id="@+id/scoreValue"
                    style="@style/ScoreValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zero" />
            </LinearLayout>

            <LinearLayout
                style="@style/ScoreBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    style="@style/ScoreLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/best" />

                <TextView
                    android:id="@+id/bestValue"
                    style="@style/ScoreValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zero" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp">

            <LinearLayout
                android:id="@+id/undoButton"
                style="@style/BoosterButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/undoIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_undo"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/undoBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_light" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hammerButton"
                style="@style/BoosterButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/hammerIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_hammer"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/hammerBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_light" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/shuffleButton"
                style="@style/BoosterButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/shuffleIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_shuffle"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/shuffleBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_light" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/megaButton"
                style="@style/BoosterButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/megaIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_mega_bomb"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/megaBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_light" />
            </LinearLayout>
        </LinearLayout>

        <com.gamekun.mergeblocks.GameView
            android:id="@+id/gameView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="12dp" />

        <LinearLayout
            android:id="@+id/adContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="50dp"
            android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/gameOverOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/stuckTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="@string/stuck_title"
            android:textColor="@color/text_light"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stuckSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/stuck_use_powerup"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <!-- Power-ups the player still owns; shown so no-moves isn't a dead end. -->
        <LinearLayout
            android:id="@+id/stuckBoosterRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/stuckUndo"
                style="@style/StuckChip"
                android:background="@drawable/booster_undo_bg">

                <ImageView style="@style/StuckChipIcon" android:src="@drawable/ic_undo" />

                <TextView android:id="@+id/stuckUndoBadge" style="@style/StuckChipBadge" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stuckHammer"
                style="@style/StuckChip"
                android:layout_marginStart="10dp"
                android:background="@drawable/booster_hammer_bg">

                <ImageView style="@style/StuckChipIcon" android:src="@drawable/ic_hammer" />

                <TextView android:id="@+id/stuckHammerBadge" style="@style/StuckChipBadge" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stuckShuffle"
                style="@style/StuckChip"
                android:layout_marginStart="10dp"
                android:background="@drawable/booster_shuffle_bg">

                <ImageView style="@style/StuckChipIcon" android:src="@drawable/ic_shuffle" />

                <TextView android:id="@+id/stuckShuffleBadge" style="@style/StuckChipBadge" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stuckMega"
                style="@style/StuckChip"
                android:layout_marginStart="10dp"
                android:background="@drawable/booster_mega_bg">

                <ImageView style="@style/StuckChipIcon" android:src="@drawable/ic_mega_bomb" />

                <TextView android:id="@+id/stuckMegaBadge" style="@style/StuckChipBadge" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/stuckOr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/or_divider"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/extraLifeButton"
            style="@style/OverlayButton"
            android:layout_marginTop="14dp"
            android:background="@drawable/menu_btn_gold"
            android:text="@string/extra_life"
            android:textColor="@color/text_dark" />

        <TextView
            android:id="@+id/powerupsButton"
            style="@style/OverlayButton"
            android:background="@drawable/menu_btn_green"
            android:text="@string/free_powerups"
            android:textColor="@color/text_light" />

        <TextView
            android:id="@+id/tryAgainButton"
            style="@style/OverlayButton"
            android:background="@drawable/menu_btn_dark"
            android:text="@string/try_again"
            android:textColor="@color/text_light" />
    </LinearLayout>
</FrameLayout>

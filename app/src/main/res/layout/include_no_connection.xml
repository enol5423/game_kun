<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/noConnectionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F22E1A47"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_wifi"
        app:tint="@color/danger"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:importantForAccessibility="no" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/no_connection_title"
        android:textColor="@color/text_light"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/no_connection_body"
        android:textColor="@color/text_dim"
        android:textSize="15sp" />

    <Button
        android:id="@+id/retryButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/menu_btn_gold"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/retry"
        android:textColor="@color/text_dark"
        android:textStyle="bold" />
</LinearLayout>
